network:
  version: 2
  wifis:
    wlan0:
      dhcp4: no
      addresses: [192.168.32.30/24]
      nameservers:
        addresses: [192.168.32.1]
      routes:
        - to: default
          via: 192.168.32.1
      regulatory-domain: "DE"
      access-points:
        "WLAN-Heck":
          password: "WIFI_PASSWORD"
      optional: true
